<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Lead Management User</label>
    <description>リード管理・スコアリングシステムの利用者向け権限セット。Lead / Lead_Interest__c の CRUD・FLS と、関連 Apex クラスへのアクセスを最小限の原則で付与する。</description>
    <hasActivationRequired>false</hasActivationRequired>

    <!-- ===== Apex クラスアクセス（9本のロジッククラス） ===== -->
    <classAccesses>
        <apexClass>LeadController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LeadService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LeadScoringService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LeadAttributeScorer</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LeadBehaviorScorer</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LeadInterestScorer</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LeadValidator</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LeadTriggerHandler</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LeadConstants</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- ===== オブジェクト権限（CRUD） ===== -->
    <objectPermissions>
        <object>Lead</object>
        <allowRead>true</allowRead>
        <allowCreate>true</allowCreate>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Lead_Interest__c</object>
        <allowRead>true</allowRead>
        <allowCreate>true</allowCreate>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <!-- ===== Lead カスタム項目の FLS（7項目・Read/Edit） ===== -->
    <fieldPermissions>
        <field>Lead.Score__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Lead.Attribute_Score__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Lead.Behavior_Score__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Lead.Interest_Score__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Lead.Lead_Category__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Lead.Score_Last_Calculated__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Lead.Last_Action_Date__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>

    <!-- ===== Lead_Interest__c カスタム項目の FLS ===== -->
    <!-- Interest_Topic__c / Interest_Level__c は「必須」項目のため FLS 指定不可。
         オブジェクト権限により暗黙的に Read/Edit 可能。 -->
    <fieldPermissions>
        <field>Lead_Interest__c.Lead__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Lead_Interest__c.Detected_Date__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Lead_Interest__c.Source__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Lead_Interest__c.Notes__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>

    <!-- ===== タブ表示 ===== -->
    <tabSettings>
        <tab>standard-Lead</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Lead_Interest__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>

    <!-- ===== アプリ表示 ===== -->
    <applicationVisibilities>
        <application>Lead_Management</application>
        <visible>true</visible>
    </applicationVisibilities>
</PermissionSet>
