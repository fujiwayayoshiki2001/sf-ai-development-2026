/**
 * テストデータを生成するファクトリクラス。
 *
 * 各テストクラスは @TestSetup や個別テスト内でこのクラスのメソッドを呼び出し、
 * リード・興味・キャンペーン・キャンペーンメンバーを一括生成する。
 * insert はあえて行わず List を返すのみとし、呼び出し側で必要なタイミングで
 * insert できるようにしている（バルクテストでの件数調整を容易にするため）。
 */
@isTest
public class TestDataFactory {

    // createInterests / createCampaignMembers で循環利用する選択肢
    private static final List<String> INTEREST_TOPICS = new List<String>{
        'データ統合', '業務効率化', 'セキュリティ強化', 'コスト削減', 'DX 推進',
        '既存システム置き換え', 'クラウド移行', '自動化', 'AI 活用', 'ガバナンス強化'
    };

    /**
     * 指定件数の Lead を生成して返す（未 insert）。
     * @param count 生成件数
     * @return 生成された Lead のリスト
     */
    public static List<Lead> createLeads(Integer count) {
        List<Lead> leads = new List<Lead>();
        for (Integer i = 0; i < count; i++) {
            leads.add(new Lead(
                FirstName = 'Test',
                LastName = 'User' + i,
                Company = 'Test Company ' + i,
                Title = 'Manager',
                Industry = LeadConstants.INDUSTRY_TECHNOLOGY,
                NumberOfEmployees = 1000,
                LeadSource = LeadConstants.SOURCE_WEBINAR,
                Email = 'test' + i + '@example.com'
            ));
        }
        return leads;
    }

    /**
     * 各 Lead に対して perLead 件の Lead_Interest__c を生成して返す（未 insert）。
     * Lead__c は Lookup のため、呼び出し側で leads を先に insert しておくこと。
     * @param leads   親となる Lead（insert 済みであること）
     * @param perLead 1 リードあたりの興味レコード数
     * @return 生成された Lead_Interest__c のリスト
     */
    public static List<Lead_Interest__c> createInterests(List<Lead> leads, Integer perLead) {
        List<Lead_Interest__c> interests = new List<Lead_Interest__c>();
        if (leads == null || leads.isEmpty() || perLead == null || perLead <= 0) {
            return interests;
        }
        for (Lead lead : leads) {
            for (Integer i = 0; i < perLead; i++) {
                String topic = INTEREST_TOPICS[Math.mod(i, INTEREST_TOPICS.size())];
                interests.add(new Lead_Interest__c(
                    Lead__c = lead.Id,
                    Interest_Topic__c = topic,
                    Interest_Level__c = Math.mod(i * 17 + 30, 100) + 1, // 1〜100 の範囲
                    Detected_Date__c = Date.today().addDays(-i),
                    Source__c = 'Test',
                    Notes__c = 'Generated by TestDataFactory'
                ));
            }
        }
        return interests;
    }

    /**
     * 指定件数の Campaign を生成して返す（未 insert）。
     * @param count 生成件数
     * @return 生成された Campaign のリスト
     */
    public static List<Campaign> createCampaigns(Integer count) {
        List<Campaign> campaigns = new List<Campaign>();
        for (Integer i = 0; i < count; i++) {
            campaigns.add(new Campaign(
                Name = 'Test Campaign ' + i,
                Type = 'Webinar',
                IsActive = true
            ));
        }
        return campaigns;
    }

    /**
     * 各 Lead を各 Campaign に紐づける CampaignMember を生成して返す（未 insert）。
     * leads・campaigns ともに insert 済みであること。
     * Status は標準で用意される 'Sent' を使用する。
     * @param leads     対象 Lead（insert 済み）
     * @param campaigns 対象 Campaign（insert 済み）
     * @return 生成された CampaignMember のリスト
     */
    public static List<CampaignMember> createCampaignMembers(List<Lead> leads, List<Campaign> campaigns) {
        List<CampaignMember> members = new List<CampaignMember>();
        if (leads == null || leads.isEmpty() || campaigns == null || campaigns.isEmpty()) {
            return members;
        }
        for (Campaign campaign : campaigns) {
            for (Lead lead : leads) {
                members.add(new CampaignMember(
                    CampaignId = campaign.Id,
                    LeadId = lead.Id,
                    Status = 'Sent'
                ));
            }
        }
        return members;
    }
}
